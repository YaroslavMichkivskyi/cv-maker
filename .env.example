# cv-maker paths. Copy to .env and adjust. Relative paths resolve from this folder.

# Source of truth: resume.data.json, master-resume.md, amendments.md, original/
CV_SOURCE_DIR=../../librarium/cv

# One subfolder per application is written here
CV_OUTPUT_DIR=../../domains/career/applications

# File name of every generated CV
CV_FILE_NAME=cv.pdf

# Optional: browser used to print the PDF (Chrome or Edge)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
